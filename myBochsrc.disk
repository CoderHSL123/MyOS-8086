#此文件为bochs配置模拟计算机的硬件配置文件
#1. 设置bochs在运行过程中能够使用的内存，此处为32MB
megs: 32

#2. 设置对应真实机器的BIOS和VGA 设置对应真实机器的BIOS和VGA
romimage: file=/usr/local/hslDir/InstalledSoftDirectory/bochs/share/bochs/BIOS-bochs-latest
vgaromimage: file=/usr/local/hslDir/InstalledSoftDirectory/bochs/share/bochs/VGABIOS-lgpl-latest

#3. 设置Bochs所使用的的硬盘，软盘的关键字为floppy
#如果只有一个软盘，则使用floppya即可，如果有多个，则是floppya、floppyb...
#floppya: 1_44=a.img, status=inserted

#4. 选择启动盘符
#boot: floppy   #默认从软盘启动
boot: disk      #从硬盘启动

#5. 设置日志文件的输出
log: bochs.out

#6. 开启或关闭某些功能
#以下是关闭鼠标，打开键盘
mouse: enabled=0
keyboard:keymap=/usr/local/hslDir/InstalledSoftDirectory/bochs/share/bochs/keymaps/x11-pc-us.map


# 硬盘设置
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14


ata0-master: type=disk, path="myhd60M.img", mode=flat, cylinders=121, heads=16, spt=63
#ata0-slave: type=disk, path="myhd80M.img", mode=flat, cylinders=162, heads=16, spt=63








# 一下是增加bochs对gdb的支持，这样gdb可以远程连接到及其的1234端口进行调试
#gdbstub: enabled=1, prot=1234, text_base=0, data_base=0, bss_base=0